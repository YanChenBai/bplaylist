{
  "name": "@bplaylist/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "自定义 B 站播放列表，串联视频、分集与跨集片段。",
  "author": "YanChenBai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanChenBai/bplaylist.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vpx ../../scripts/generate-icons.ts && vld dev --watch",
    "build": "vpx ../../scripts/generate-icons.ts && vue-tsc --noEmit && vld build",
    "preview": "vld preview",
    "typecheck": "vue-tsc --noEmit",
    "package": "vp run build && electron-builder --win",
    "test:smoke": "vpx ../../scripts/smoke.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bplaylist/bridge": "workspace:*",
    "@bplaylist/shared": "workspace:*",
    "@bplaylist/ui": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@pinia/colada": "1.4.8",
    "@vueuse/core": "^14.4.0",
    "cn": "^0.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "motion-v": "2.8.0",
    "pinia": "4.1.0",
    "vue": "3.6.0-rc.13",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "drizzle-kit": "1.0.0-rc.5",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "veldorajs": "0.0.5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "3.3.13"
  }
}
