{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["@nativescript/types", "nativescript-vue"]
  },
  "vueCompilerOptions": { "target": 3, "lib": "nativescript-vue" },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
